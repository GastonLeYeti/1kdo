# Instagram handle of the admin (without @). Only this account sees the QG.
ADMIN_INSTA=
# Secret invitation code the admin uses for her very first sign-up: /?i=<ADMIN_INVITE>&u=<ADMIN_INSTA>
ADMIN_INVITE=
# Long random string used to sign session cookies (openssl rand -base64 48).
SESSION_SECRET=
# Filled in automatically by the Vercel × Upstash integration. Leave empty locally: an in-memory store is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
